---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import constituencyData from "../../../data/registry/constituencies.json";
import { getRegionGroups, resolveConstituencyRegion, type RegionGroup } from "../../../lib/regions";
import { SITE_URL } from "../../../lib/site";

type Constituency = { slug: string; name: string; region: string | null; ladCodes: string[] };

export function getStaticPaths() {
  return getRegionGroups().map((region) => ({
    params: { slug: region.slug },
    props: { region },
  }));
}

const { region } = Astro.props as { region: RegionGroup };
// Constituencies whose own local authorities place them in this region.
const constituencies = Object.values(constituencyData as Record<string, Constituency>)
  .filter((constituency) => resolveConstituencyRegion(constituency.region, constituency.ladCodes)?.slug === region.slug)
  .sort((left, right) => left.name.localeCompare(right.name));
const firstNames = region.places.slice(0, 5).map((place) => place.displayName);
const description = region.places.length > 5
  ? `${region.name}: ${region.places.length} local authority records on UK Places, including ${firstNames.join(", ")}. Each record links to its detailed sources.`
  : `${region.name}: ${region.places.length} local authority records on UK Places: ${firstNames.join(", ")}. Each record links to its detailed sources.`;
const canonicalUrl = `${SITE_URL}/places/regions/${region.slug}/`;
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "UK Places", item: `${SITE_URL}/` },
      { "@type": "ListItem", position: 2, name: "Places", item: `${SITE_URL}/places/` },
      { "@type": "ListItem", position: 3, name: region.name, item: canonicalUrl },
    ],
  },
];
---

<BaseLayout title={`${region.name}: local authorities and constituencies`} description={description} structuredData={structuredData}>
  <main class="shell directory-page" id="main-content">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">UK Places</a>
      <span aria-hidden="true">/</span>
      <a href="/places/">Places</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{region.name}</span>
    </nav>

    <section class="directory-hero">
      <p class="eyebrow">{region.country}</p>
      <h1>{region.name}</h1>
      <p>{region.places.length} local-authority geography records{constituencies.length > 0 && ` and ${constituencies.length} Westminster constituencies`}.</p>
    </section>

    <div class="directory-groups">
      <section class="directory-group">
        <h2>{region.name} local authorities</h2>
        <ul class="directory-list">
          {region.places.map((place) => (
            <li><a href={`/places/${place.slug}/`}>{place.displayName}<span>{place.type}</span></a></li>
          ))}
        </ul>
      </section>
      {constituencies.length > 0 && (
        <section class="directory-group">
          <h2>{region.name} constituencies</h2>
          <ul class="directory-list">
            {constituencies.map((constituency) => (
              <li><a href={`/constituencies/${constituency.slug}/`}>{constituency.name}<span>Westminster constituency</span></a></li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </main>
</BaseLayout>
